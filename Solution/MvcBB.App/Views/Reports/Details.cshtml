@using MvcBB.Shared.Interfaces
@model ReportResponse
@inject IBBCodeService BBCodeService
@{
    ViewData["Title"] = $"Report #{Model.Id}";
    Layout = "_AdminLayout";
}

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
            <li class="breadcrumb-item active" aria-current="page">Report #@Model.Id</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Report Details -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Report Details</h4>
                </div>
                <div class="card-body">
                    @if (!Model.HasContent)
                    {
                        <div class="mb-4">
                            <h5>Site Issue</h5>
                            <dl class="row">
                                <dt class="col-sm-3">Type</dt>
                                <dd class="col-sm-9"><i class="bi bi-bug me-1"></i>@Model.TypeName</dd>

                                <dt class="col-sm-3">Page</dt>
                                <dd class="col-sm-9">
                                    @if (!string.IsNullOrEmpty(Model.PageUrl) && Url.IsLocalUrl(Model.PageUrl))
                                    {
                                        <a href="@Model.PageUrl" class="text-break">@Model.PageUrl</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not included</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    }
                    else
                    {
                    <div class="mb-4">
                        <h5>Reported Content</h5>
                        <dl class="row">
                            <dt class="col-sm-3">Type</dt>
                            <dd class="col-sm-9">@Model.TypeName</dd>

                            <dt class="col-sm-3">Content</dt>
                            <dd class="col-sm-9">
                                @switch (Model.Type)
                                {
                                    case ReportType.Thread when Model.ContentThreadId.HasValue:
                                        <a asp-controller="Threads" asp-action="Details" asp-route-id="@Model.ContentThreadId">
                                            @Model.ContentTitle
                                        </a>
                                        break;
                                    case ReportType.Post when Model.ContentThreadId.HasValue:
                                        @* ContentId is the post's id: link to its thread, anchored at the post. *@
                                        <a asp-controller="Threads" asp-action="Details" asp-route-id="@Model.ContentThreadId" asp-fragment="post-@Model.ContentId">
                                            @Model.ContentTitle (post #@Model.ContentId)
                                        </a>
                                        break;
                                    case ReportType.Thread:
                                    case ReportType.Post:
                                        <span class="text-muted">This @Model.TypeName.ToLower() no longer exists (#@Model.ContentId).</span>
                                        break;
                                    case ReportType.Message:
                                        @* No link: the message page only opens for its sender and recipient.
                                           The reported text is shown below instead. *@
                                        @(string.IsNullOrEmpty(Model.ContentTitle) ? $"Private message #{Model.ContentId}" : Model.ContentTitle)
                                        break;
                                    case ReportType.User:
                                        <a asp-controller="Account" asp-action="Profile" asp-route-username="@Model.ContentTitle">
                                            @Model.ContentTitle
                                        </a>
                                        break;
                                }
                            </dd>

                            <dt class="col-sm-3">Content Author</dt>
                            <dd class="col-sm-9">@Model.ContentAuthorUsername</dd>

                            <dt class="col-sm-3">Content Created</dt>
                            <dd class="col-sm-9">@(await Html.FormatDateTimeAsync(Model.ContentCreatedAt))</dd>
                        </dl>

                        @if (Model.Type == ReportType.Message)
                        {
                            @if (Model.MessageContent != null)
                            {
                                <dl class="row mb-2">
                                    <dt class="col-sm-3">Sent To</dt>
                                    <dd class="col-sm-9">@Model.MessageRecipientUsername</dd>
                                </dl>
                                <div class="card">
                                    <div class="card-header small text-muted">
                                        <i class="bi bi-shield-lock me-1"></i>Shown to moderators because this message was reported.
                                    </div>
                                    <div class="card-body message-content">
                                        @Html.Raw(BBCodeService.ParseBBCode(Model.MessageContent, ViewData["Smilies"] as Dictionary<string, string>))
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">The message's text isn't available. It may have been deleted.</p>
                            }
                        }
                    </div>
                    }

                    <div class="mb-4">
                        <h5>Report Information</h5>
                        <dl class="row">
                            <dt class="col-sm-3">Reported By</dt>
                            <dd class="col-sm-9">@Model.ReporterUsername</dd>

                            <dt class="col-sm-3">Reported At</dt>
                            <dd class="col-sm-9">@(await Html.FormatDateTimeAsync(Model.CreatedAt))</dd>

                            <dt class="col-sm-3">Status</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-@GetStatusColor(Model.Status)">@Model.Status</span>
                            </dd>

                            <dt class="col-sm-3">@(Model.HasContent ? "Reason" : "Description")</dt>
                            <dd class="col-sm-9">@Model.Reason</dd>

                            @if (Model.ResolvedAt.HasValue)
                            {
                                <dt class="col-sm-3">Resolved By</dt>
                                <dd class="col-sm-9">@Model.ResolvedByUsername</dd>

                                <dt class="col-sm-3">Resolved At</dt>
                                <dd class="col-sm-9">@(await Html.FormatDateTimeAsync(Model.ResolvedAt.Value))</dd>
                            }
                        </dl>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ModeratorNotes))
                    {
                        <div class="mb-4">
                            <h5>Moderator Notes</h5>
                            <div class="card bg-light">
                                <div class="card-body">
                                    @Model.ModeratorNotes
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Update Status -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Update Status</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select name="Status" class="form-select">
                                @foreach (ReportStatus status in Enum.GetValues(typeof(ReportStatus)))
                                {
                                    <option value="@status" selected="@(status == Model.Status)">@status</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Moderator Notes</label>
                            <textarea name="ModeratorNotes" class="form-control" rows="5">@Model.ModeratorNotes</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Update Status</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

@functions {
    private string GetStatusColor(ReportStatus status) => status switch
    {
        ReportStatus.Pending => "warning",
        ReportStatus.Investigating => "info",
        ReportStatus.Resolved => "success",
        ReportStatus.Dismissed => "secondary",
        _ => "primary"
    };
} 