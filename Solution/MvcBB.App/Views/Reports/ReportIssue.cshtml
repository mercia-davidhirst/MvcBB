@model CreateReportRequest

@{
    ViewData["Title"] = "Report an Issue";
    var includePageUrl = ViewData["IncludePageUrl"] as bool? ?? false;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card mt-4">
                <div class="card-body">
                    <h1 class="card-title h3 mb-3"><i class="bi bi-bug me-2"></i>Report an issue</h1>
                    <p class="text-muted">
                        Found something broken or not working as expected? Tell the forum team what happened
                        and they'll take a look.
                    </p>

                    <form asp-action="ReportIssue" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="PageUrl" />

                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label">What went wrong?</label>
                            <textarea asp-for="Reason" class="form-control" rows="5" maxlength="500" required
                                      placeholder="What were you doing, what did you expect, and what happened instead?"></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.PageUrl))
                        {
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="includePageUrl" id="includePageUrl" value="true" checked="@includePageUrl" />
                                <label class="form-check-label" for="includePageUrl">
                                    Include the page I was on: <code class="text-break">@Model.PageUrl</code>
                                </label>
                            </div>
                        }

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Send report</button>
                            @if (!string.IsNullOrEmpty(Model.PageUrl))
                            {
                                <a href="@Model.PageUrl" class="btn btn-secondary">Cancel</a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
