@model IEnumerable<MvcBB.Shared.Models.User.UserResponse>
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Rank / Title</th>
                    <th>Joined</th>
                    <th>Last Login</th>
                    <th>Activity</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Account" asp-action="Profile" asp-route-username="@user.Username"
                               target="_blank" rel="noopener">
                                @user.Username
                            </a>
                        </td>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge bg-@(user.Role == UserRole.Administrator ? "danger" :
                                                  user.Role == UserRole.Moderator ? "warning" :
                                                  user.Role == UserRole.Deleted ? "secondary" : "primary")">
                                @user.RoleName
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(user.RankTitle))
                            {
                                <span>@user.RankTitle</span>
                                @if (string.IsNullOrEmpty(user.CustomTitle))
                                {
                                    <small class="text-muted d-block">(computed)</small>
                                }
                                else
                                {
                                    <small class="text-muted d-block">(custom)</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>@(user.LastLoginAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                        <td>
                            <small>
                                Threads: @user.ThreadCount<br />
                                Posts: @user.PostCount
                            </small>
                        </td>
                        <td>
                            @{
                                var isCurrentUser = string.Equals(user.Username, User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                            }
                            @if (user.Role != UserRole.Deleted)
                            {
                                @if (isCurrentUser)
                                {
                                    <span class="text-muted small d-block mb-1">You can't change your own role</span>
                                }
                                else
                                {
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                            Change Role
                                        </button>
                                        <ul class="dropdown-menu">
                                            @foreach (UserRole role in Enum.GetValues(typeof(UserRole)))
                                            {
                                                @* Deleted is only reachable via the dedicated Anonymize action below,
                                                   never from the normal role-escalation dropdown. *@
                                                @if (role != user.Role && role != UserRole.Deleted)
                                                {
                                                    <li>
                                                        <form asp-action="UpdateUserRole" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@user.Id" />
                                                            <input type="hidden" name="newRole" value="@((int)role)" />
                                                            <button type="submit" class="dropdown-item">
                                                                Make @role.ToString()
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal" data-bs-target="#customTitleModal@(user.Id)">
                                    Set Title
                                </button>

                                <div class="modal fade" id="customTitleModal@(user.Id)" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Set Custom Title for @user.Username</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="SetCustomTitle" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <div class="modal-body">
                                                    <label for="customTitle@(user.Id)" class="form-label">Custom title</label>
                                                    <input type="text" name="customTitle" id="customTitle@(user.Id)"
                                                           class="form-control" maxlength="70" value="@user.CustomTitle" />
                                                    <small class="form-text text-muted">
                                                        Replaces this user's computed rank everywhere it's shown. Leave blank to clear it and go back to the computed rank.
                                                    </small>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Save</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                @if (!isCurrentUser)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#anonymizeModal@(user.Id)">
                                        Delete
                                    </button>

                                    <div class="modal fade" id="anonymizeModal@(user.Id)" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Delete User</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Are you sure you want to delete "@user.Username"?</p>
                                                    <p class="text-muted">
                                                        This anonymizes the account rather than removing it: their existing
                                                        posts and threads stay intact under a generic username, and the
                                                        account moves to the Deleted role. This cannot be undone.
                                                    </p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="AnonymizeUser" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        <button type="submit" class="btn btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

@section Scripts {
    <script>
        // Auto-close alerts after 5 seconds
        setTimeout(function () {
            $('.alert').alert('close');
        }, 5000);
    </script>
} 