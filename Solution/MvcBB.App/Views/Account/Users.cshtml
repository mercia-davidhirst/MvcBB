@model MvcBB.App.Models.AdminUsersViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";

    // Passed to each user's page so its "Back to users" link (and the
    // redirect after any action) returns to this exact search/page.
    var listUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex flex-wrap gap-2 align-items-start justify-content-between mb-3">
    <form method="get" asp-action="Users" class="d-flex flex-wrap gap-2 flex-grow-1" style="max-width: 40rem;">
        <input type="hidden" name="sortBy" value="@Model.SortBy" />
        <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
        <div class="input-group flex-grow-1" style="min-width: 14rem; width: auto;">
            <input type="search" class="form-control" name="search" value="@Model.Search"
                   placeholder="Search by username or email" aria-label="Search by username or email" maxlength="50" />
            <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
        </div>
        <select class="form-select w-auto" name="role" aria-label="Filter by role" onchange="this.form.submit()">
            <option value="">All roles</option>
            @foreach (UserRole role in Enum.GetValues(typeof(UserRole)))
            {
                <option value="@((int)role)" selected="@(Model.Role == role)">@role.ToString()</option>
            }
        </select>
        @if (Model.IsFiltered)
        {
            <a asp-action="Users" class="btn btn-outline-secondary">Clear</a>
        }
    </form>

    <a asp-action="CreateUser" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Create User
    </a>
</div>

@if (!Model.Users.Any())
{
    <div class="alert alert-info">
        @(Model.IsFiltered ? "No users match your search." : "There are no users yet.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>
                        <a href="@Model.GetSortUrl("username", Url)" class="text-dark text-decoration-none">
                            User <i class="bi @Model.GetSortIcon("username")"></i>
                        </a>
                    </th>
                    <th>Role / status</th>
                    <th class="d-none d-lg-table-cell">Last login</th>
                    <th class="d-none d-md-table-cell text-end">
                        <a href="@Model.GetSortUrl("posts", Url)" class="text-dark text-decoration-none">
                            Posts <i class="bi @Model.GetSortIcon("posts")"></i>
                        </a>
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <a href="@Model.GetSortUrl("joined", Url)" class="text-dark text-decoration-none">
                            Joined <i class="bi @Model.GetSortIcon("joined")"></i>
                        </a>
                    </th>
                    <th><span class="visually-hidden">Manage</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var manageUrl = Url.Action("ManageUser", "Account", new { id = user.Id, returnUrl = listUrl });

                    @* The whole row opens the user's admin page (see the script below).
                       The username stays a real link, styled as plain text rather than
                       like the profile links elsewhere, so keyboard users, middle-click
                       and "open in new tab" still work. *@
                    <tr class="admin-user-row" data-href="@manageUrl">
                        <td>
                            <a href="@manageUrl" class="fw-semibold text-reset text-decoration-none" title="Manage @user.Username">
                                @user.Username
                            </a>
                            @if (!string.IsNullOrEmpty(user.Email))
                            {
                                <small class="text-muted d-block text-break">@user.Email</small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-@(user.Role == UserRole.Administrator ? "danger" :
                                                  user.Role == UserRole.Moderator ? "warning" :
                                                  user.Role == UserRole.Deleted ? "secondary" : "primary")">
                                @user.RoleName
                            </span>
                            @if (user.IsLocked)
                            {
                                <span class="badge bg-dark" title="Locked until @(user.LockedUntil.HasValue ? await Html.FormatDateTimeAsync(user.LockedUntil.Value) : "")">
                                    <i class="bi bi-lock"></i> Locked
                                </span>
                            }
                            @if (user.MustChangePassword)
                            {
                                <span class="badge bg-info" title="Must set a new password on next login">Password reset</span>
                            }
                        </td>
                        <td class="d-none d-lg-table-cell">
                            @(user.LastLoginAt.HasValue ? await Html.FormatDateTimeAsync(user.LastLoginAt.Value) : "Never")
                        </td>
                        <td class="d-none d-md-table-cell text-end">@user.PostCount</td>
                        <td class="d-none d-lg-table-cell">@(await Html.FormatDateTimeAsync(user.CreatedAt))</td>
                        <td class="text-end text-nowrap">
                            <span class="btn btn-sm btn-outline-secondary" aria-hidden="true">
                                Manage <i class="bi bi-chevron-right"></i>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
        <div class="text-muted small">
            Showing @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalUsers)
            of @Model.TotalUsers users
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="User pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Model.GetPageUrl(Math.Max(1, Model.Page - 1), Url)" aria-label="Previous">&laquo;</a>
                    </li>
                    @foreach (var p in Model.GetPagerPages())
                    {
                        if (p == null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Model.GetPageUrl(p.Value, Url)">@p</a>
                            </li>
                        }
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Model.GetPageUrl(Math.Min(Model.TotalPages, Model.Page + 1), Url)" aria-label="Next">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@section Scripts {
    <script>
        // Clicking anywhere on a user row opens that user's admin page.
        // Ctrl/Cmd-click opens it in a new tab, like a normal link would;
        // clicks on the row's own link, or while selecting text, are left alone.
        document.querySelectorAll('tr.admin-user-row[data-href]').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.closest('a, button, input, select, label')) return;
                if (window.getSelection && window.getSelection().toString().length > 0) return;
                var url = row.getAttribute('data-href');
                if (e.ctrlKey || e.metaKey) {
                    window.open(url, '_blank');
                } else {
                    window.location.href = url;
                }
            });
        });

        // Auto-close alerts after 5 seconds
        setTimeout(function () {
            $('.alert-dismissible').alert('close');
        }, 5000);
    </script>
}
