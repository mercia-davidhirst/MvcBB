@using MvcBB.Shared.Interfaces
@model UpdatePostRequest
@inject IBBCodeService BBCodeService
@{
    ViewData["Title"] = "Edit Post";
    var post = ViewData["Post"] as PostResponse;
    var threadTitle = ViewData["ThreadTitle"] as string;
    var smilies = ViewData["Smilies"] as Dictionary<string, string>;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Boards" asp-action="Index">Boards</a></li>
            <li class="breadcrumb-item"><a asp-controller="Threads" asp-action="Details" asp-route-id="@post.ThreadId">@threadTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Post</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">Edit Post</h4>
        </div>
        <div class="card-body">
            <form asp-action="EditPost" asp-route-id="@post.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label">Content</label>
                    <partial name="_BBCodeToolbar" model="smilies" />
                    <textarea asp-for="Content" class="form-control" rows="10" required
                              oninput="updatePreview()">@post.Content</textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>

                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-2">Preview</h5>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    onclick="togglePreview()">
                                <i class="bi bi-eye"></i> Toggle Preview
                            </button>
                        </div>
                        <div id="preview" class="bbcode-preview"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="EditReason" class="form-label">Edit Reason</label>
                    <input asp-for="EditReason" class="form-control" required />
                    <span asp-validation-for="EditReason" class="text-danger"></span>
                    <div class="form-text">Please provide a reason for editing this post.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Attached Image</label>
                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@post.ImageUrl" alt="Attached image" class="img-fluid rounded" style="max-height: 150px;" />
                        </div>
                        <div class="form-check mb-2">
                            <input type="checkbox" name="removeImage" id="removeImage" class="form-check-input" value="true" />
                            <label for="removeImage" class="form-check-label">Remove current image</label>
                        </div>
                    }
                    <label for="imageFile" class="form-label">@(string.IsNullOrEmpty(post.ImageUrl) ? "Attach Image (optional)" : "Replace Image (optional)")</label>
                    <input type="file" name="imageFile" id="imageFile" class="form-control" accept=".png,.jpg,.jpeg,.gif" />
                    <small class="form-text text-muted">PNG, JPG, or GIF, up to 2 MB.</small>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Details" asp-route-id="@post.ThreadId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let previewVisible = true;

        function updatePreview() {
            if (!previewVisible) return;

            const content = document.getElementById('Content').value;
            fetch('/api/bbcode/preview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ content })
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('preview').innerHTML = html;
            });
        }

        function togglePreview() {
            const preview = document.getElementById('preview');
            previewVisible = !previewVisible;
            if (previewVisible) {
                preview.style.display = 'block';
                updatePreview();
            } else {
                preview.style.display = 'none';
            }
        }

        // Initial preview
        updatePreview();
    </script>
} 