@using MvcBB.Shared.Interfaces
@model CreatePostRequest
@inject IBBCodeService BBCodeService
@{
    ViewData["Title"] = "Reply to Thread";
    var quotedPost = ViewData["QuotedPost"] as PostResponse;
    var threadTitle = ViewData["ThreadTitle"] as string;
    var smilies = ViewData["Smilies"] as Dictionary<string, string>;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Boards" asp-action="Index">Boards</a></li>
            <li class="breadcrumb-item"><a asp-controller="Threads" asp-action="Details" asp-route-id="@Model.ThreadId">@threadTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">Reply</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">Post Reply</h4>
        </div>
        <div class="card-body">
            @if (quotedPost != null)
            {
                <div class="quote-block mb-4 p-3 border-start border-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted">
                            <a asp-controller="Threads" asp-action="Details" asp-route-id="@Model.ThreadId" asp-fragment="post-@quotedPost.Id" class="text-decoration-none">
                                @quotedPost.CreatedByUsername wrote <i class="bi bi-arrow-up-short"></i>
                            </a>
                        </small>
                        <small class="text-muted">@(await Html.FormatDateTimeAsync(quotedPost.CreatedAt))</small>
                    </div>
                    <div class="quoted-content">@Html.Raw(BBCodeService.ParseBBCode(quotedPost.Content, smilies))</div>
                </div>
            }

            <form asp-action="CreatePost" asp-route-threadId="@Model.ThreadId" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @if (quotedPost != null)
                {
                    <input type="hidden" name="QuotedPostId" value="@quotedPost.Id" />
                }
                <div class="form-group">
                    <label for="Content">Your Reply</label>
                    <partial name="_BBCodeToolbar" model="smilies" />
                    <textarea name="Content" id="Content" class="form-control" rows="10" required
                              oninput="updatePreview()"></textarea>

                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-2">Preview</h5>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    onclick="togglePreview()">
                                <i class="bi bi-eye"></i> Toggle Preview
                            </button>
                        </div>
                        <div id="preview" class="bbcode-preview"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="imageFile" class="form-label">Attach Image (optional)</label>
                    <input type="file" name="imageFile" id="imageFile" class="form-control" accept=".png,.jpg,.jpeg,.gif" />
                    <small class="form-text text-muted">PNG, JPG, or GIF, up to 2 MB.</small>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Post Reply</button>
                    <a asp-action="Details" asp-route-id="@Model.ThreadId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let previewVisible = true;
        const quotedPreviewHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            quotedPost != null
                ? $"<blockquote class=\"blockquote\"><p class=\"mb-0\">{BBCodeService.ParseBBCode(quotedPost.Content, smilies)}</p><footer class=\"blockquote-footer\"><cite>{quotedPost.CreatedByUsername}</cite></footer></blockquote>"
                : ""));

        function updatePreview() {
            if (!previewVisible) return;

            const content = document.getElementById('Content').value;
            fetch('/api/bbcode/preview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ content })
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('preview').innerHTML = quotedPreviewHtml + html;
            });
        }

        function togglePreview() {
            const preview = document.getElementById('preview');
            previewVisible = !previewVisible;
            if (previewVisible) {
                preview.style.display = 'block';
                updatePreview();
            } else {
                preview.style.display = 'none';
            }
        }

        // Initial preview
        updatePreview();
    </script>
} 