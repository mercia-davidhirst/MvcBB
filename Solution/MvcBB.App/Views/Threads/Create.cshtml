@using MvcBB.Shared.Interfaces
@using MvcBB.Shared.Models.ForumThread

@model CreateForumThreadRequest
@inject IBBCodeService BBCodeService
@{
    ViewData["Title"] = "Create New Thread";
    var boardName = ViewData["BoardName"] as string;
    var boardId = ViewData["BoardId"] as int?;
    var smilies = ViewData["Smilies"] as Dictionary<string, string>;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Boards" asp-action="Index">Boards</a></li>
            <li class="breadcrumb-item"><a asp-controller="Boards" asp-action="Details" asp-route-id="@boardId">@boardName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create New Thread</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">Create New Thread in @boardName</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BoardId" value="@boardId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Thread Title</label>
                    <input asp-for="Title" class="form-control" required maxlength="200" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label">Content</label>
                    <partial name="_BBCodeToolbar" model="smilies" />
                    <textarea asp-for="Content" class="form-control" rows="10" required
                              oninput="updatePreview()"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>

                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-2">Preview</h5>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    onclick="togglePreview()">
                                <i class="bi bi-eye"></i> Toggle Preview
                            </button>
                        </div>
                        <div id="preview" class="bbcode-preview"></div>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="addPollCheck" onchange="togglePoll()" />
                    <label class="form-check-label" for="addPollCheck">Add a poll</label>
                </div>

                <div id="pollSection" class="card mb-3" style="display:none;">
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="pollQuestion" class="form-label">Poll Question</label>
                            <input type="text" name="pollQuestion" id="pollQuestion" class="form-control" maxlength="200" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Options</label>
                            <div id="pollOptionsList">
                                <div class="input-group mb-2">
                                    <input type="text" name="pollOptions" class="form-control" placeholder="Option 1" maxlength="100" />
                                </div>
                                <div class="input-group mb-2">
                                    <input type="text" name="pollOptions" class="form-control" placeholder="Option 2" maxlength="100" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addPollOption()">
                                <i class="bi bi-plus-lg"></i> Add Option
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Create Thread</button>
                    <a asp-controller="Boards" asp-action="Details" asp-route-id="@boardId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let previewVisible = true;

        function updatePreview() {
            if (!previewVisible) return;

            const content = document.getElementById('Content').value;
            fetch('/api/bbcode/preview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ content })
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('preview').innerHTML = html;
            });
        }

        function togglePreview() {
            const preview = document.getElementById('preview');
            previewVisible = !previewVisible;
            if (previewVisible) {
                preview.style.display = 'block';
                updatePreview();
            } else {
                preview.style.display = 'none';
            }
        }

        // Initial preview
        updatePreview();

        function togglePoll() {
            const section = document.getElementById('pollSection');
            section.style.display = document.getElementById('addPollCheck').checked ? 'block' : 'none';
        }

        function addPollOption() {
            const list = document.getElementById('pollOptionsList');
            const count = list.querySelectorAll('input[name="pollOptions"]').length + 1;
            const div = document.createElement('div');
            div.className = 'input-group mb-2';
            div.innerHTML = `<input type="text" name="pollOptions" class="form-control" placeholder="Option ${count}" maxlength="100" />`;
            list.appendChild(div);
        }
    </script>
} 