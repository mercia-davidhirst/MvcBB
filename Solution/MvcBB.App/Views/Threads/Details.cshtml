@using System.Security.Claims
@using MvcBB.Shared.Interfaces
@model ThreadResponse
@inject IBBCodeService BBCodeService
@{
    ViewData["Title"] = Model.Title;
    var posts = (IEnumerable<PostResponse>)ViewData["Posts"];
    var smilies = ViewData["Smilies"] as Dictionary<string, string>;
    var isMod = User.IsInRole("Administrator") || User.IsInRole("Moderator");
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Boards" asp-action="Index">Boards</a></li>
            <li class="breadcrumb-item"><a asp-controller="Boards" asp-action="Details" asp-route-id="@Model.BoardId">@Model.BoardName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="card mb-4">
        <div class="card-header thread-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">@Model.Title</h4>
            <div>
                @if (!Model.IsLocked || User.IsInRole("Administrator") || User.IsInRole("Moderator"))
                {
                    <a asp-action="Reply" asp-route-threadId="@Model.Id" class="btn btn-success">Reply</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="btn-group">
                        <button type="button" class="btn @(Model.IsSubscribed ? "btn-info" : "btn-outline-light")" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi @(Model.IsSubscribed ? "bi-eye-fill" : "bi-eye")"></i> @(Model.IsSubscribed ? "Watching" : "Watch")
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                            <form asp-action="Watch" asp-route-threadId="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <p class="small text-muted">Notify me of new replies via:</p>
                                <div class="form-check">
                                    <input type="checkbox" name="notifyViaMessage" value="true" class="form-check-input" id="notifyViaMessage" @(Model.NotifyViaMessage ? "checked" : "") />
                                    <label class="form-check-label" for="notifyViaMessage">Private message</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input type="checkbox" name="notifyViaEmail" value="true" class="form-check-input" id="notifyViaEmail" @(Model.NotifyViaEmail ? "checked" : "") />
                                    <label class="form-check-label" for="notifyViaEmail">Email</label>
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary w-100">@(Model.IsSubscribed ? "Update" : "Subscribe")</button>
                            </form>
                            @if (Model.IsSubscribed)
                            {
                                <form asp-action="Unwatch" asp-route-threadId="@Model.Id" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Unwatch</button>
                                </form>
                            }
                        </div>
                    </div>
                }
                <a asp-controller="Reports" asp-action="Create"
                   asp-route-type="Thread" asp-route-contentId="@Model.Id"
                   class="btn btn-warning">
                    <i class="bi bi-flag"></i> Report
                </a>
                @if (isMod)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteThreadModal">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                }
            </div>
        </div>
    </div>

    @if (isMod)
    {
        <div class="modal fade" id="deleteThreadModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Thread</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete "@Model.Title"?</p>
                        <p class="text-danger">This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="d-flex flex-wrap gap-4 text-muted mb-4 small">
        <span><i class="bi bi-chat-left-text"></i> @Model.ReplyCount @(Model.ReplyCount == 1 ? "Reply" : "Replies")</span>
        <span><i class="bi bi-eye"></i> @Model.ViewCount @(Model.ViewCount == 1 ? "View" : "Views")</span>
        <span><i class="bi bi-hand-thumbs-up"></i> @Model.TotalLikes @(Model.TotalLikes == 1 ? "Like" : "Likes")</span>
        <span><i class="bi bi-people"></i> @Model.ParticipantCount @(Model.ParticipantCount == 1 ? "Participant" : "Participants")</span>
        @if (!string.IsNullOrEmpty(Model.LastPostByUsername))
        {
            <span><i class="bi bi-clock-history"></i> Last post by <strong>@Model.LastPostByUsername</strong> @(Model.LastPostAt.HasValue ? await Html.FormatDateTimeAsync(Model.LastPostAt.Value) : "")</span>
        }
    </div>

    @if (Model.Poll != null)
    {
        var poll = Model.Poll;
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> @poll.Question</h5>
            </div>
            <div class="card-body">
                @if (User.Identity?.IsAuthenticated == true && !poll.HasVoted)
                {
                    <form asp-action="VotePoll" asp-route-threadId="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        @foreach (var option in poll.Options)
                        {
                            <div class="form-check mb-2">
                                <input type="radio" name="pollOptionId" value="@option.Id" class="form-check-input" id="pollOption@(option.Id)" required />
                                <label class="form-check-label" for="pollOption@(option.Id)">@option.Text</label>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary btn-sm mt-2">Vote</button>
                    </form>
                }
                else
                {
                    foreach (var option in poll.Options)
                    {
                        var pct = poll.TotalVotes == 0 ? 0 : (int)Math.Round(option.VoteCount * 100.0 / poll.TotalVotes);
                        <div class="mb-2">
                            <div class="d-flex justify-content-between">
                                <span>
                                    @option.Text
                                    @if (poll.VotedOptionId == option.Id)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Your vote"></i>
                                    }
                                </span>
                                <span class="text-muted">@option.VoteCount (@pct%)</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar" role="progressbar" style="width: @(pct)%;"></div>
                            </div>
                        </div>
                    }
                    <small class="text-muted">@poll.TotalVotes total @(poll.TotalVotes == 1 ? "vote" : "votes")</small>
                }
            </div>
        </div>
    }

    @if (posts != null && posts.Any())
    {
        <div class="thread-posts mb-4">
            @foreach (var post in posts)
            {
                <div class="card" id="post-@post.Id">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(post.CreatedByAvatarUrl))
                            {
                                <img src="@post.CreatedByAvatarUrl" alt="@post.CreatedByUsername" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle me-2" style="font-size: 32px; line-height: 1;"></i>
                            }
                            <div>
                                <strong>
                                    <a asp-controller="Account" asp-action="Profile" asp-route-username="@post.CreatedByUsername" class="text-decoration-none">
                                        @post.CreatedByUsername
                                    </a>
                                </strong>
                                @if (!string.IsNullOrEmpty(post.CreatedByRankTitle))
                                {
                                    <small class="d-block">
                                        @if (!string.IsNullOrEmpty(post.CreatedByRankImagePath))
                                        {
                                            <img src="@post.CreatedByRankImagePath" alt="@post.CreatedByRankTitle" style="height: 14px;" class="me-1" />
                                        }
                                        <span class="text-muted">@post.CreatedByRankTitle</span>
                                    </small>
                                }
                                <small class="text-muted d-block">
                                    posted @(await Html.FormatDateTimeAsync(post.CreatedAt))
                                    @if (post.IsEdited)
                                    {
                                        <span>(edited @(post.UpdatedAt.HasValue ? await Html.FormatDateTimeAsync(post.UpdatedAt.Value) : ""))</span>
                                    }
                                </small>
                            </div>
                        </div>
                        <div class="post-actions">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="LikePost" asp-route-id="@post.Id" asp-route-threadId="@Model.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-hand-thumbs-up@(post.IsLikedByCurrentUser ? "-fill" : "")"></i>
                                        @(post.LikeCount > 0 ? post.LikeCount.ToString() : "Like")
                                    </button>
                                </form>
                            }
                            else if (post.LikeCount > 0)
                            {
                                <span class="btn btn-sm btn-primary disabled">
                                    <i class="bi bi-hand-thumbs-up"></i> @post.LikeCount
                                </span>
                            }
                            @if (User.Identity?.IsAuthenticated == true && post.CreatedByUserId != currentUserId)
                            {
                                <a asp-controller="Messages" asp-action="Create" asp-route-recipientId="@post.CreatedByUserId"
                                   class="btn btn-sm btn-secondary">
                                    <i class="bi bi-envelope"></i> PM
                                </a>
                            }
                            @if (!Model.IsLocked || User.IsInRole("Administrator") || User.IsInRole("Moderator"))
                            {
                                <a asp-action="QuotePost" asp-route-threadId="@Model.Id" asp-route-postId="@post.Id"
                                   class="btn btn-sm btn-secondary">
                                    <i class="bi bi-quote"></i> Quote
                                </a>
                            }
                            @if (isMod || post.CreatedByUserId == currentUserId)
                            {
                                <a asp-action="EditPost" asp-route-id="@post.Id"
                                   class="btn btn-sm btn-secondary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            }
                            <a asp-controller="Reports" asp-action="Create"
                               asp-route-type="Post" asp-route-contentId="@post.Id"
                               class="btn btn-sm btn-warning">
                                <i class="bi bi-flag"></i> Report
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (post.QuotedPost != null)
                        {
                            <blockquote class="blockquote mb-3">
                                <p class="mb-0">@Html.Raw(BBCodeService.ParseBBCode(post.QuotedPost.Content, smilies))</p>
                                <footer class="blockquote-footer">
                                    <a href="#post-@post.QuotedPost.Id" class="text-decoration-none">
                                        <cite>@post.QuotedPost.CreatedByUsername</cite> wrote this <i class="bi bi-arrow-up-short"></i>
                                    </a>
                                </footer>
                            </blockquote>
                        }
                        @Html.Raw(BBCodeService.ParseBBCode(post.Content, smilies))
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <div class="mt-3">
                                <img src="@post.ImageUrl" alt="Attached image" class="img-fluid rounded" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No posts found in this thread.</div>
    }

    @if (Model.IsLocked && !User.IsInRole("Administrator") && !User.IsInRole("Moderator"))
    {
        <div class="alert alert-warning">
            <i class="bi bi-lock-fill"></i> This thread is locked. New replies cannot be posted.
        </div>
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card">
            <div class="card-header quick-reply-header">
                <h5 class="mb-0">Quick Reply</h5>
            </div>
            <div class="card-body">
                <form asp-action="CreatePost" asp-route-threadId="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <partial name="_BBCodeToolbar" model="smilies" />
                        <textarea name="Content" id="Content" class="form-control" rows="5" required
                                  oninput="updatePreview()"></textarea>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-2">Preview</h5>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="togglePreview()">
                                    <i class="bi bi-eye"></i> Toggle Preview
                                </button>
                            </div>
                            <div id="preview" class="bbcode-preview"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="imageFile" class="form-label">Attach Image (optional)</label>
                        <input type="file" name="imageFile" id="imageFile" class="form-control" accept=".png,.jpg,.jpeg,.gif" />
                        <small class="form-text text-muted">PNG, JPG, or GIF, up to 2 MB.</small>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Post Reply</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Please <a asp-controller="Account" asp-action="Login">login</a> to post replies.
        </div>
    }
</div>

@section Scripts {
    <script>
        let previewVisible = true;

        function updatePreview() {
            if (!previewVisible) return;
            
            const content = document.getElementById('Content').value;
            fetch('/api/bbcode/preview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ content })
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('preview').innerHTML = html;
            });
        }

        function togglePreview() {
            const preview = document.getElementById('preview');
            previewVisible = !previewVisible;
            if (previewVisible) {
                preview.style.display = 'block';
                updatePreview();
            } else {
                preview.style.display = 'none';
            }
        }

        // Initial preview
        updatePreview();
    </script>
} 