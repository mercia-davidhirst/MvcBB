@using MvcBB.Shared.Models.AdminEmail
@model EmailActivity
@{
    ViewData["Title"] = "Sending activity";
    Layout = "_AdminLayout";
    var ranges = new[] { ("24h", "24 hours"), ("7d", "7 days"), ("30d", "30 days") };

    // Axis labels and bar descriptions in the forum's time zone and formats.
    var labels = new List<string>();
    var periods = new List<string>();
    foreach (var bucket in Model.Buckets)
    {
        if (Model.Hourly)
        {
            var from = await Html.FormatTimeAsync(bucket.StartUtc);
            labels.Add(from);
            periods.Add($"{await Html.FormatDateAsync(bucket.StartUtc)} {from}-{await Html.FormatTimeAsync(bucket.EndUtc)}");
        }
        else
        {
            var day = await Html.FormatDateAsync(bucket.StartUtc);
            labels.Add((await Html.ToForumTimeAsync(bucket.StartUtc)).ToString("d MMM"));
            periods.Add(day);
        }
    }
    var chart = new EmailActivityChart(Model, labels);
    var unit = Model.Hourly ? "hour" : "day";
    var F = (Func<double, string>)EmailActivityChart.F;
}

<div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Email Users
    </a>
    <div class="btn-group btn-group-sm" role="group" aria-label="Period">
        @foreach (var (value, text) in ranges)
        {
            <a asp-action="Activity" asp-route-range="@value" class="btn @(Model.Range == value ? "btn-primary" : "btn-outline-primary")"
               aria-current="@(Model.Range == value ? "page" : null)">@text</a>
        }
    </div>
</div>

<p class="text-muted">
    Every email the site has sent - emails from Email Users, password resets, notifications and the rest - since hosts
    that cap sending count them all. Use it to pick a quiet time for a large email.
</p>

<div class="card mb-4">
    <div class="card-header">Right now</div>
    <div class="card-body">
        <partial name="_EmailUsage" model="Model.Usage" />
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>Emails sent per @unit, last @ranges.First(r => r.Item1 == Model.Range).Item2</span>
        <span class="email-chart-legend small">
            @foreach (var (_, cssClass, name) in EmailActivityChart.Kinds)
            {
                <span class="me-2 text-nowrap"><span class="email-chart-swatch @cssClass"></span>@name</span>
            }
            @if (Model.Hourly)
            {
                <span class="me-2 text-nowrap"><span class="email-chart-swatch email-chart-swatch-line"></span>Rolling 60 minutes</span>
            }
        </span>
    </div>
    <div class="card-body">
        <svg class="email-chart" viewBox="0 0 @F(EmailActivityChart.Width) @F(EmailActivityChart.Height)" role="img"
             aria-labelledby="emailChartTitle emailChartDesc" preserveAspectRatio="xMidYMid meet">
            <title id="emailChartTitle">Emails sent per @unit</title>
            <desc id="emailChartDesc">
                Stacked bars by kind of email@(chart.Limit > 0 ? $", against the host limit of {chart.Limit} per {unit}" : "").
                The same figures are in the table under "Show data".
            </desc>

            @foreach (var (y, value) in chart.Ticks)
            {
                @* SVG <text> is wrapped in <g> throughout: on its own in a code block Razor reads it as its own <text> tag. *@
                <g>
                    <line class="email-chart-grid" x1="@F(EmailActivityChart.Left)" x2="@F(EmailActivityChart.Width - EmailActivityChart.Right)" y1="@F(y)" y2="@F(y)" />
                    <text class="email-chart-axis" x="@F(EmailActivityChart.Left - 6)" y="@F(y + 4)" text-anchor="end">@value</text>
                </g>
            }

            @for (var i = 0; i < chart.Bars.Count; i++)
            {
                var bar = chart.Bars[i];
                var description = bar.Describe(periods[i]);
                <g role="img" aria-label="@description">
                    <title>@description</title>
                    @* An invisible full-height target so the tooltip works on empty and short bars too. *@
                    <rect x="@F(bar.X)" y="@F(EmailActivityChart.Top)" width="@F(bar.Width)" height="@F(EmailActivityChart.PlotHeight)" fill="transparent" />
                    @foreach (var (y, height, cssClass) in bar.Segments)
                    {
                        <rect class="@cssClass" x="@F(bar.X)" y="@F(y)" width="@F(bar.Width)" height="@F(height)" />
                    }
                    @if (bar.OverSegment is (double overY, double overHeight))
                    {
                        <rect class="email-chart-over" x="@F(bar.X)" y="@F(overY)" width="@F(bar.Width)" height="@F(overHeight)" />
                    }
                </g>
                @if (bar.ShowLabel)
                {
                    <g><text class="email-chart-axis" x="@F(bar.CenterX)" y="@F(EmailActivityChart.PlotBottom + 16)" text-anchor="middle">@bar.Label</text></g>
                }
            }

            @if (chart.RollingPoints.Count > 0)
            {
                <polyline class="email-chart-rolling" points="@chart.RollingPolyline" />
                @foreach (var point in chart.RollingPoints.Where(p => p.Over))
                {
                    <circle class="email-chart-over" cx="@F(point.X)" cy="@F(point.Y)" r="3" />
                }
            }

            @if (chart.AdminShareY is double shareY)
            {
                <line class="email-chart-share" x1="@F(EmailActivityChart.Left)" x2="@F(EmailActivityChart.Width - EmailActivityChart.Right)" y1="@F(shareY)" y2="@F(shareY)" />
            }
            @if (chart.LimitY is double limitY)
            {
                <g>
                    <line class="email-chart-limit" x1="@F(EmailActivityChart.Left)" x2="@F(EmailActivityChart.Width - EmailActivityChart.Right)" y1="@F(limitY)" y2="@F(limitY)" />
                    <text class="email-chart-limit-label" x="@F(EmailActivityChart.Width - EmailActivityChart.Right - 4)" y="@F(limitY - 5)" text-anchor="end">Host limit @chart.Limit/@unit</text>
                </g>
            }

            <line class="email-chart-baseline" x1="@F(EmailActivityChart.Left)" x2="@F(EmailActivityChart.Width - EmailActivityChart.Right)"
                  y1="@F(EmailActivityChart.PlotBottom)" y2="@F(EmailActivityChart.PlotBottom)" />
        </svg>

        <p class="small text-muted mt-2 mb-0">
            @if (chart.Limit > 0)
            {
                @:The red dashed line is your host's limit of @chart.Limit a @unit; anything above it is shown in red.
                @if (chart.AdminShareY.HasValue)
                {
                    @:The dotted line below it (@chart.AdminShare) is where emails from Email Users stop, leaving the rest for password resets and other site emails.
                }
                @if (Model.Hourly)
                {
                    @:Hosts usually count any 60 minutes, not clock hours, so the line shows the total for the 60 minutes up to each point.
                }
            }
            else
            {
                @:No host limit is set for this period. Set one in <a asp-controller="Admin" asp-action="Settings">Settings</a> to see it on the chart.
            }
        </p>

        <details class="mt-3">
            <summary>Show data</summary>
            <div class="table-responsive mt-2">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@(Model.Hourly ? "Hour" : "Day")</th>
                            @foreach (var (_, _, name) in EmailActivityChart.Kinds)
                            {
                                <th scope="col" class="text-end">@name</th>
                            }
                            <th scope="col" class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Buckets.Count; i++)
                        {
                            var bucket = Model.Buckets[i];
                            <tr class="@(chart.Bars[i].Over ? "table-danger" : "")">
                                <td class="text-nowrap">@periods[i]</td>
                                @foreach (var (kind, _, _) in EmailActivityChart.Kinds)
                                {
                                    <td class="text-end">@bucket.CountOf(kind)</td>
                                }
                                <td class="text-end"><strong>@bucket.Total</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </div>
</div>
