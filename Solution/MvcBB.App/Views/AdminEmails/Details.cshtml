@using MvcBB.Shared.Models.AdminEmail
@model AdminEmail
@{
    ViewData["Title"] = "Sent email";
    Layout = "_AdminLayout";
    var recipientUsername = ViewData["RecipientUsername"] as string;
    var finished = AdminEmailDisplay.IsFinished(Model.Status);
    var percent = Model.RecipientCount == 0 ? 0 : (int)Math.Round(100.0 * (Model.SentCount + Model.FailedCount) / Model.RecipientCount);
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Email Users
    </a>
</div>

<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-break">@Model.Subject</span>
        <span>
            @if (Model.IsImportant)
            {
                <span class="badge bg-danger">Important</span>
            }
            <span class="badge @AdminEmailDisplay.StatusBadge(Model.Status)">@AdminEmailDisplay.Status(Model.Status)</span>
        </span>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <div class="d-flex justify-content-between small mb-1">
                <span>@Model.SentCount of @Model.RecipientCount sent@(Model.FailedCount > 0 ? $", {Model.FailedCount} failed" : "")</span>
                @if (!finished)
                {
                    <span class="text-muted">This page refreshes while it's sending.</span>
                }
            </div>
            <div class="progress">
                <div class="progress-bar @(Model.FailedCount > 0 ? "bg-warning" : "")" role="progressbar" style="width: @percent%"
                     aria-label="Sending progress" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        @if (Model.Status == AdminEmailStatus.Interrupted)
        {
            <div class="alert alert-warning">
                Sending stopped part way because the site restarted. It isn't restarted automatically, so members who
                already got it aren't emailed twice. Send a new email if the rest still need it.
            </div>
        }
        else if (Model.Status == AdminEmailStatus.CompletedWithErrors)
        {
            <div class="alert alert-warning">
                Some emails couldn't be sent. The API log has the reason for each one.
            </div>
        }

        <dl class="row mb-0">
            <dt class="col-sm-3">To</dt>
            <dd class="col-sm-9">
                @AdminEmailDisplay.Audience(Model)
                @if (Model.Audience == AdminEmailAudience.SingleUser && Model.UserId.HasValue)
                {
                    @:&ndash;
                    <a asp-controller="Account" asp-action="ManageUser" asp-route-id="@Model.UserId">@(recipientUsername ?? $"user #{Model.UserId}")</a>
                }
            </dd>

            <dt class="col-sm-3">From</dt>
            <dd class="col-sm-9 text-break">@AdminEmailDisplay.From(Model)</dd>

            @if (!string.IsNullOrEmpty(Model.ReplyToAddress))
            {
                <dt class="col-sm-3">Reply-To</dt>
                <dd class="col-sm-9 text-break">@Model.ReplyToAddress</dd>
            }

            <dt class="col-sm-3">Sent by</dt>
            <dd class="col-sm-9">@Model.SentByUsername</dd>

            <dt class="col-sm-3">Queued</dt>
            <dd class="col-sm-9">@(await Html.FormatDateTimeAsync(Model.CreatedAt))</dd>

            @if (Model.CompletedAt.HasValue)
            {
                <dt class="col-sm-3">Finished</dt>
                <dd class="col-sm-9">@(await Html.FormatDateTimeAsync(Model.CompletedAt.Value))</dd>
            }
        </dl>

        <hr />
        <div class="text-preserve-lines text-break">@Model.Body</div>
    </div>
</div>

@section Scripts {
    @if (!finished)
    {
        <script>
            setTimeout(function () { window.location.reload(); }, 5000);
        </script>
    }
}
