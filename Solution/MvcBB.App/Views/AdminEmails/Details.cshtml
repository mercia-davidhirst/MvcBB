@using MvcBB.Shared.Models.AdminEmail
@model AdminEmail
@{
    ViewData["Title"] = "Sent email";
    Layout = "_AdminLayout";
    var recipientUsername = ViewData["RecipientUsername"] as string;
    var failures = ViewData["Failures"] as List<AdminEmailFailure> ?? new List<AdminEmailFailure>();
    var resumeCount = ViewData["ResumeCount"] as int? ?? 0;
    var finished = AdminEmailDisplay.IsFinished(Model.Status);
    var percent = Model.RecipientCount == 0 ? 0 : (int)Math.Round(100.0 * (Model.SentCount + Model.FailedCount) / Model.RecipientCount);
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Email Users
    </a>
</div>

<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-break">@Model.Subject</span>
        <span>
            @if (Model.IsImportant)
            {
                <span class="badge bg-danger">Important</span>
            }
            <span class="badge @AdminEmailDisplay.StatusBadge(Model.Status)">@AdminEmailDisplay.Status(Model.Status)</span>
        </span>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <div class="d-flex justify-content-between small mb-1">
                <span>@Model.SentCount of @Model.RecipientCount sent@(Model.FailedCount > 0 ? $", {Model.FailedCount} failed" : "")</span>
                @if (!finished)
                {
                    <span class="text-muted">This page refreshes while it's sending.</span>
                }
            </div>
            <div class="progress">
                <div class="progress-bar @(Model.FailedCount > 0 ? "bg-warning" : "")" role="progressbar" style="width: @percent%"
                     aria-label="Sending progress" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        @if (Model.Status == AdminEmailStatus.Sending && Model.PausedUntil.HasValue)
        {
            <div class="alert alert-info">
                <i class="bi bi-hourglass-split"></i>
                Waiting for the hourly or daily sending limit. Sending resumes at @(await Html.FormatDateTimeAsync(Model.PausedUntil.Value)).
            </div>
        }

        @if (Model.Status == AdminEmailStatus.Interrupted)
        {
            <div class="alert alert-warning">
                Sending stopped part way because the site restarted. It isn't resumed automatically.
                @if (resumeCount > 0)
                {
                    @:Resuming sends it only to the @resumeCount member(s) who haven't had it yet.
                    <form asp-action="Resume" asp-route-id="@Model.Id" method="post" class="mt-2"
                          onsubmit="return confirm('This will send the email to the @resumeCount member(s) who have not had it yet. Continue?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-play-fill"></i> Resume sending
                        </button>
                    </form>
                }
                else
                {
                    @:Everyone it's for has already had it.
                }
            </div>
        }
        else if (Model.Status == AdminEmailStatus.CompletedWithErrors)
        {
            <div class="alert alert-warning">
                Some emails couldn't be sent. The members it failed for are listed below.
            </div>
        }

        <dl class="row mb-0">
            <dt class="col-sm-3">To</dt>
            <dd class="col-sm-9">
                @AdminEmailDisplay.Audience(Model)
                @if (Model.Audience == AdminEmailAudience.SingleUser && Model.UserId.HasValue)
                {
                    @:&ndash;
                    <a asp-controller="Account" asp-action="ManageUser" asp-route-id="@Model.UserId">@(recipientUsername ?? $"user #{Model.UserId}")</a>
                }
            </dd>

            <dt class="col-sm-3">From</dt>
            <dd class="col-sm-9 text-break">@AdminEmailDisplay.From(Model)</dd>

            @if (!string.IsNullOrEmpty(Model.ReplyToAddress))
            {
                <dt class="col-sm-3">Reply-To</dt>
                <dd class="col-sm-9 text-break">@Model.ReplyToAddress</dd>
            }

            <dt class="col-sm-3">Sent by</dt>
            <dd class="col-sm-9">@Model.SentByUsername</dd>

            <dt class="col-sm-3">Queued</dt>
            <dd class="col-sm-9">@(await Html.FormatDateTimeAsync(Model.CreatedAt))</dd>

            @if (Model.CompletedAt.HasValue)
            {
                <dt class="col-sm-3">Finished</dt>
                <dd class="col-sm-9">@(await Html.FormatDateTimeAsync(Model.CompletedAt.Value))</dd>
            }
        </dl>

        <hr />
        <div class="text-preserve-whitespace text-break">@Model.Body</div>
    </div>
</div>

@if (failures.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">Failed recipients (@failures.Count)</div>
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Member</th>
                        <th scope="col">Email</th>
                        <th scope="col">Reason</th>
                        <th scope="col">Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var failure in failures)
                    {
                        <tr>
                            <td><a asp-controller="Account" asp-action="ManageUser" asp-route-id="@failure.UserId">@failure.Username</a></td>
                            <td class="text-break">@failure.Email</td>
                            <td class="text-break">@failure.Reason</td>
                            <td class="text-nowrap"><small>@(await Html.FormatDateTimeAsync(failure.FailedAt))</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    @if (!finished)
    {
        <script>
            setTimeout(function () { window.location.reload(); }, 5000);
        </script>
    }
}
