@using MvcBB.Shared.Models.Announcement
@model IEnumerable<AnnouncementModel>
@{
    ViewData["Title"] = "Manage Announcements";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="AddAnnouncement" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Announcement
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Order</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var announcement in Model.OrderBy(a => a.SortOrder))
                    {
                        <tr>
                            <td>@announcement.Title</td>
                            <td>
                                <span class="badge bg-@(announcement.IsActive ? "success" : "danger")">
                                    @(announcement.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@announcement.SortOrder</td>
                            <td>@(announcement.StartDate.HasValue ? await Html.FormatDateTimeAsync(announcement.StartDate.Value) : "-")</td>
                            <td>@(announcement.EndDate.HasValue ? await Html.FormatDateTimeAsync(announcement.EndDate.Value) : "-")</td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="EditAnnouncement" asp-route-id="@announcement.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteAnnouncement" asp-route-id="@announcement.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this announcement?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
