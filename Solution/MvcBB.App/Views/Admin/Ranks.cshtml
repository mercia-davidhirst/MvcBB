@using MvcBB.Shared.Models.Rank
@model IEnumerable<RankModel>
@{
    ViewData["Title"] = "Manage Ranks";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="AddRank" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Rank
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Minimum Posts</th>
                        <th>Status</th>
                        <th>Order</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rank in Model.OrderBy(r => r.SortOrder))
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(rank.ImagePath))
                                {
                                    <img src="@rank.ImagePath" alt="@rank.Title" style="height: 20px;" />
                                }
                            </td>
                            <td>@rank.Title</td>
                            <td>@rank.MinPosts</td>
                            <td>
                                <span class="badge bg-@(rank.IsActive ? "success" : "danger")">
                                    @(rank.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@rank.SortOrder</td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="EditRank" asp-route-id="@rank.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteRank" asp-route-id="@rank.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this rank?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
