@using MvcBB.Shared.Models.Settings
@model DisplaySettingsViewModel
@{
    ViewData["Title"] = "Display Settings";
    Layout = "_AdminLayout";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Display settings</h5>
    </div>
    <div class="card-body">
        <form asp-action="Settings" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LogoPath" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="SiteName" class="form-label"></label>
                <input asp-for="SiteName" class="form-control" />
                <span asp-validation-for="SiteName" class="text-danger"></span>
                <small class="form-text text-muted">Shown in the page title and footer.</small>
            </div>

            <div class="mb-3">
                <label asp-for="LogoFile" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <div class="mb-2">
                        <img src="@Model.LogoPath" alt="@Model.SiteName" style="max-height: 48px;" />
                    </div>
                    <div class="form-check mb-2">
                        <input asp-for="RemoveLogo" class="form-check-input" type="checkbox" />
                        <label asp-for="RemoveLogo" class="form-check-label"></label>
                    </div>
                }
                <input asp-for="LogoFile" class="form-control" type="file" accept=".png,.jpg,.jpeg,.gif" />
                <span asp-validation-for="LogoFile" class="text-danger"></span>
                <small class="form-text text-muted">Shown in the top-left of every page. PNG, JPG, or GIF, up to 2 MB. Leave blank to keep the current logo, or use plain site name text if none is set.</small>
            </div>

            <div class="mb-3">
                <label asp-for="ThreadsPerPage" class="form-label">Threads per page</label>
                <input asp-for="ThreadsPerPage" class="form-control" type="number" min="1" max="100" />
                <span asp-validation-for="ThreadsPerPage" class="text-danger"></span>
                <small class="form-text text-muted">When listing all threads, this many threads are shown per page (1–100). Used when the number of threads exceeds this value.</small>
            </div>

            <div class="mb-3">
                <label asp-for="SiteTitle" class="form-label"></label>
                <input asp-for="SiteTitle" class="form-control" />
                <span asp-validation-for="SiteTitle" class="text-danger"></span>
                <small class="form-text text-muted">Shown as the main heading on the home page.</small>
            </div>

            <div class="mb-3">
                <label asp-for="WelcomeMessage" class="form-label"></label>
                <textarea asp-for="WelcomeMessage" class="form-control" rows="3"></textarea>
                <span asp-validation-for="WelcomeMessage" class="text-danger"></span>
                <small class="form-text text-muted">Shown beneath the title on the home page.</small>
            </div>

            <div class="mb-3">
                <label asp-for="FooterDisclaimer" class="form-label"></label>
                <textarea asp-for="FooterDisclaimer" class="form-control" rows="2"></textarea>
                <span asp-validation-for="FooterDisclaimer" class="text-danger"></span>
                <small class="form-text text-muted">Optional centered text shown in the footer on every page (e.g. a disclaimer). Leave blank to show nothing.</small>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="RegistrationEnabled" class="form-check-input" />
                    <label asp-for="RegistrationEnabled" class="form-check-label"></label>
                </div>
                <small class="form-text text-muted">When off, the public registration page is disabled - new accounts can only be created by an admin (Users &gt; Create User).</small>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DateFormat" class="form-label"></label>
                    <select asp-for="DateFormat" class="form-select">
                        @foreach (var (value, label) in DateFormatOptions.DateFormats)
                        {
                            <option value="@value" selected="@(Model.DateFormat == value)">@label (@DateTime.Now.ToString(value))</option>
                        }
                    </select>
                    <span asp-validation-for="DateFormat" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TimeFormat" class="form-label"></label>
                    <select asp-for="TimeFormat" class="form-select">
                        @foreach (var (value, label) in DateFormatOptions.TimeFormats)
                        {
                            <option value="@value" selected="@(Model.TimeFormat == value)">@label (@DateTime.Now.ToString(value))</option>
                        }
                    </select>
                    <span asp-validation-for="TimeFormat" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <small class="form-text text-muted">Controls how dates and times are displayed everywhere on the site (e.g. post times, "joined" dates). Example: @DateTime.Now.ToString($"{Model.DateFormat} {Model.TimeFormat}")</small>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save settings</button>
            </div>
        </form>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Password policy</h5>
    </div>
    <div class="card-body">
        @{
            // A separate <form>/action/model (PasswordPolicy, not
            // DisplaySettingsViewModel) so saving this doesn't need the
            // display-settings fields (SiteTitle etc.) to also be present and
            // valid - these two groups are independent API resources
            // (api/settings/display vs api/settings/password-policy).
        }
        <form asp-action="PasswordPolicy" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="MinimumLength" class="form-label">Minimum Length</label>
                <input name="MinimumLength" id="MinimumLength" class="form-control" type="number" min="4" max="100"
                       style="max-width: 10rem;" value="@Model.PasswordPolicy.MinimumLength" />
            </div>

            <div class="mb-2 form-check">
                <input type="checkbox" name="RequireUppercase" id="RequireUppercase" class="form-check-input"
                       value="true" checked="@Model.PasswordPolicy.RequireUppercase" />
                <label for="RequireUppercase" class="form-check-label">Require an uppercase letter</label>
            </div>
            <div class="mb-2 form-check">
                <input type="checkbox" name="RequireLowercase" id="RequireLowercase" class="form-check-input"
                       value="true" checked="@Model.PasswordPolicy.RequireLowercase" />
                <label for="RequireLowercase" class="form-check-label">Require a lowercase letter</label>
            </div>
            <div class="mb-2 form-check">
                <input type="checkbox" name="RequireDigit" id="RequireDigit" class="form-check-input"
                       value="true" checked="@Model.PasswordPolicy.RequireDigit" />
                <label for="RequireDigit" class="form-check-label">Require a digit</label>
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" name="RequireSpecialCharacter" id="RequireSpecialCharacter" class="form-check-input"
                       value="true" checked="@Model.PasswordPolicy.RequireSpecialCharacter" />
                <label for="RequireSpecialCharacter" class="form-check-label">Require a special character</label>
            </div>

            <small class="form-text text-muted d-block mb-3">
                Applies to new registrations, admin-created accounts, password changes, and password resets from this point on - it doesn't retroactively invalidate existing passwords.
            </small>

            <button type="submit" class="btn btn-primary">Save password policy</button>
        </form>

        <hr />

        <form asp-action="RequirePasswordChangeForAll" method="post"
              onsubmit="return confirm('This will require every user to set a new password the next time they log in. Continue?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                Force password reset for all users
            </button>
            <small class="form-text text-muted d-block mt-1">
                Use this after tightening the policy above, to make sure everyone's password actually complies with it.
            </small>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
