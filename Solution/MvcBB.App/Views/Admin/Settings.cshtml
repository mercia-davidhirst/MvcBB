@model DisplaySettingsViewModel
@{
    ViewData["Title"] = "Display Settings";
    Layout = "_AdminLayout";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Display settings</h5>
    </div>
    <div class="card-body">
        <form asp-action="Settings" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="SiteName" class="form-label"></label>
                <input asp-for="SiteName" class="form-control" />
                <span asp-validation-for="SiteName" class="text-danger"></span>
                <small class="form-text text-muted">Shown in the page title and footer.</small>
            </div>

            <div class="mb-3">
                <label asp-for="LogoFile" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <div class="mb-2">
                        <img src="@Model.LogoPath" alt="@Model.SiteName" style="max-height: 48px;" />
                    </div>
                    <div class="form-check mb-2">
                        <input asp-for="RemoveLogo" class="form-check-input" type="checkbox" />
                        <label asp-for="RemoveLogo" class="form-check-label"></label>
                    </div>
                }
                <input asp-for="LogoFile" class="form-control" type="file" accept=".png,.jpg,.jpeg,.gif" />
                <span asp-validation-for="LogoFile" class="text-danger"></span>
                <small class="form-text text-muted">Shown in the top-left of every page. PNG, JPG, or GIF, up to 2 MB. Leave blank to keep the current logo, or use plain site name text if none is set.</small>
            </div>

            <div class="mb-3">
                <label asp-for="ThreadsPerPage" class="form-label">Threads per page</label>
                <input asp-for="ThreadsPerPage" class="form-control" type="number" min="1" max="100" />
                <span asp-validation-for="ThreadsPerPage" class="text-danger"></span>
                <small class="form-text text-muted">When listing all threads, this many threads are shown per page (1–100). Used when the number of threads exceeds this value.</small>
            </div>

            <div class="mb-3">
                <label asp-for="SiteTitle" class="form-label"></label>
                <input asp-for="SiteTitle" class="form-control" />
                <span asp-validation-for="SiteTitle" class="text-danger"></span>
                <small class="form-text text-muted">Shown as the main heading on the home page.</small>
            </div>

            <div class="mb-3">
                <label asp-for="WelcomeMessage" class="form-label"></label>
                <textarea asp-for="WelcomeMessage" class="form-control" rows="3"></textarea>
                <span asp-validation-for="WelcomeMessage" class="text-danger"></span>
                <small class="form-text text-muted">Shown beneath the title on the home page.</small>
            </div>

            <div class="mb-3">
                <label asp-for="FooterDisclaimer" class="form-label"></label>
                <textarea asp-for="FooterDisclaimer" class="form-control" rows="2"></textarea>
                <span asp-validation-for="FooterDisclaimer" class="text-danger"></span>
                <small class="form-text text-muted">Optional centered text shown in the footer on every page (e.g. a disclaimer). Leave blank to show nothing.</small>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save settings</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
