@using MvcBB.Shared.Models.WordFilter
@model IEnumerable<WordFilterModel>
@{
    ViewData["Title"] = "Word Filter";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="AddWordFilter" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Filtered Word
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Word</th>
                        <th>Replacement</th>
                        <th>Status</th>
                        <th>Order</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var filter in Model.OrderBy(f => f.SortOrder))
                    {
                        <tr>
                            <td>@filter.Word</td>
                            <td>@filter.Replacement</td>
                            <td>
                                <span class="badge bg-@(filter.IsActive ? "success" : "danger")">
                                    @(filter.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@filter.SortOrder</td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="EditWordFilter" asp-route-id="@filter.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteWordFilter" asp-route-id="@filter.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this word filter?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
