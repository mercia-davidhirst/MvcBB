@model HomeViewModel
@inject MvcBB.App.Interfaces.IModsService ModsService
@inject IReadOnlyList<IAppMod> DiscoveredAppMods

@{
    ViewData["Title"] = "Home";
    // One context shared by every home page slot (home.sidebar, home.left,
    // home.center.top, home.center, home.right). Empty slots render nothing
    // at all, so a site without slot-using mods gets exactly the core layout.
    var homeSlot = new PageSlotContext { ViewerUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value };
    // Enabled mods' nav links, for Quick Links (the enabled set is cached by ModsService).
    var enabledModIds = await ModsService.GetEnabledModIdsAsync();
    var modNavItems = DiscoveredAppMods
        .Where(m => enabledModIds.Contains(m.Id))
        .SelectMany(m => m.GetNavItems())
        .ToList();
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="jumbotron bg-light p-5 rounded">
                <h1 class="display-4">@Model.SiteTitle</h1>
                <p class="lead text-preserve-lines">@Model.WelcomeMessage</p>
                @if (!User.Identity?.IsAuthenticated == true)
                {
                    <hr class="my-4">
                    <p>Join our community today to participate in discussions!</p>
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register" role="button">Sign Up</a>
                    <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Login" role="button">Login</a>
                }
            </div>
        </div>
    </div>

    <!-- Three Panel Layout -->
    <div class="row">
        <!-- Left Panel (15%) -->
        <div class="col-12 col-md-2">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a asp-controller="Boards" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="bi bi-grid-3x3-gap me-2"></i> All Boards
                        </a>
                        <a asp-controller="Members" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="bi bi-people me-2"></i> Members
                        </a>
                        <a asp-controller="Team" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="bi bi-shield-check me-2"></i> Team
                        </a>
                        <a asp-controller="Search" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="bi bi-search me-2"></i> Search
                        </a>
                        @* The same links enabled mods add to the navbar (IAppMod.GetNavItems), all of them. *@
                        @foreach (var navItem in modNavItems)
                        {
                            <a asp-controller="@navItem.Controller" asp-action="@navItem.Action" class="list-group-item list-group-item-action">
                                <i class="bi @navItem.IconCssClass me-2"></i> @navItem.Text
                            </a>
                        }
                    </div>
                </div>
            </div>

            @* home.sidebar: the original home slot, still in its original place. *@
            <mod-slot name="@CoreSlots.HomeSidebar" context="@homeSlot" />
            <mod-slot name="@CoreSlots.HomeLeft" context="@homeSlot" />
        </div>

        <!-- Center Panel (70%) -->
        <div class="col-12 col-md-8">
            <mod-slot name="@CoreSlots.HomeCenterTop" context="@homeSlot" />
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Latest Discussions</h5>
                    <a asp-controller="Boards" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (Model?.LatestThreads?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var thread in Model.LatestThreads)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">
                                            <partial name="_ThreadFlagIcons" model="thread" />
                                            <a asp-controller="Threads" asp-action="Details" asp-route-id="@thread.Id" 
                                               class="text-decoration-none">@thread.Title</a>
                                            <partial name="_ThreadActivityIcon" model="thread" />
                                        </h6>
                                        <small class="text-muted text-nowrap ms-2">Replies: @thread.ReplyCount</small>
                                    </div>
                                    <p class="mb-1">
                                        <small class="text-muted">
                                            Started by 
                                            <a asp-controller="Account" asp-action="Profile" asp-route-username="@thread.CreatedByUsername" 
                                               class="text-decoration-none">@thread.CreatedByUsername</a>
                                            on @(await Html.FormatDateTimeAsync(thread.CreatedAt)) in 
                                            <a asp-controller="Boards" asp-action="Details" asp-route-id="@thread.BoardId" 
                                               class="text-decoration-none">@thread.BoardName</a>
                                        </small>
                                    </p>
                                    @if (thread.LastPostAt.HasValue)
                                    {
                                        <p class="mb-0">
                                            <small class="text-muted">
                                                Last post by 
                                                <a asp-controller="Account" asp-action="Profile" asp-route-username="@thread.LastPostByUsername" 
                                                   class="text-decoration-none">@thread.LastPostByUsername</a>
                                                on <a asp-controller="Threads" asp-action="Details" asp-route-id="@thread.Id" asp-route-last="true" class="text-decoration-none" title="Go to the last post">@(await Html.FormatDateTimeAsync(thread.LastPostAt.Value)) <i class="bi bi-box-arrow-in-down-right"></i></a>
                                            </small>
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center my-4">No discussions found.</p>
                    }
                </div>
            </div>

            <mod-slot name="@CoreSlots.HomeCenter" context="@homeSlot" />
        </div>

        <!-- Right Panel (15%) -->
        <div class="col-12 col-md-2">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item">
                            <small class="d-block text-muted">Members</small>
                            <strong>@(Model?.Stats?.TotalMembers ?? 0)</strong>
                        </div>
                        <div class="list-group-item">
                            <small class="d-block text-muted">Threads</small>
                            <strong>@(Model?.Stats?.TotalThreads ?? 0)</strong>
                        </div>
                        <div class="list-group-item">
                            <small class="d-block text-muted">Posts</small>
                            <strong>@(Model?.Stats?.TotalPosts ?? 0)</strong>
                        </div>
                        <div class="list-group-item">
                            <small class="d-block text-muted">Active Users</small>
                            <strong>@(Model?.Stats?.ActiveUsers ?? 0)</strong>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model?.NewestMembers?.Any() == true)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Newest Members</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            @foreach (var member in Model.NewestMembers)
                            {
                                <a asp-controller="Account" asp-action="Profile" asp-route-username="@member.Username"
                                   class="list-group-item list-group-item-action">
                                    <i class="bi bi-person-circle me-2"></i>
                                    @member.Username
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            <mod-slot name="@CoreSlots.HomeRight" context="@homeSlot" />
        </div>
    </div>
</div>
