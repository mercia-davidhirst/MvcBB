@using MvcBB.Shared.Models.ForumThread
@model BoardResponse

@{
    ViewData["Title"] = Model.Name;
    var threads = ViewData["Threads"] as IEnumerable<ThreadResponse> ?? Enumerable.Empty<ThreadResponse>();
    var page = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a asp-action="Index">Boards</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                        </ol>
                    </nav>
                    <h1 class="mt-2">
                        @Model.Name
                        @if (Model.IsPrivate)
                        {
                            <span class="badge bg-warning"><i class="bi bi-lock-fill"></i> Private</span>
                        }
                    </h1>
                    <p class="text-muted">@Model.Description</p>
                </div>
                <div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Threads" asp-action="Create" asp-route-boardId="@Model.Id" 
                           class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> New Thread
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary ms-2">
                            <i class="bi bi-pencil"></i> Edit Board
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-9">
            @if (Model.ThreadCount == 0)
            {
                <div class="alert alert-info">
                    <p class="mb-0">No threads have been created in this board yet.</p>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <p class="mt-2 mb-0">
                            <a asp-controller="Threads" asp-action="Create" asp-route-boardId="@Model.Id">Create the first thread</a>
                        </p>
                    }
                    else
                    {
                        <p class="mt-2 mb-0">
                            Please <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">login</a> 
                            or <a asp-controller="Account" asp-action="Register">register</a> to create a thread.
                        </p>
                    }
                </div>
            }
            else
            {
                <partial name="Components/ThreadList/Default" model="threads" />

                @if (totalPages > 1)
                {
                    <nav aria-label="Thread pages" class="mt-4">
                        <ul class="pagination justify-content-center">
                            @for (var i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == page ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Details", new { id = Model.Id, page = i })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>

        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Board Statistics</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Threads
                            <span class="badge bg-primary rounded-pill">@Model.ThreadCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Posts
                            <span class="badge bg-primary rounded-pill">@Model.PostCount</span>
                        </li>
                    </ul>
                </div>
            </div>

            @if (Model.LastPostAt.HasValue)
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Latest Activity</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-1">
                            <a asp-controller="Threads" asp-action="Details" asp-route-id="@Model.LastThreadId" 
                               class="text-decoration-none">
                                @Model.LastThreadTitle
                            </a>
                        </p>
                        <small class="text-muted">
                            by 
                            <a asp-controller="Account" asp-action="Profile" asp-route-username="@Model.LastPostByUsername" 
                               class="text-decoration-none">
                                @Model.LastPostByUsername
                            </a>
                            <br />
                            @(await Html.FormatDateTimeAsync(Model.LastPostAt.Value))
                        </small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
