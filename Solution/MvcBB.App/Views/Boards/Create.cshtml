@model CreateBoardRequest
@{
    var boardsForParentList = (IEnumerable<BoardResponse>)(ViewData["Boards"] ?? Array.Empty<BoardResponse>());
}

@{
    ViewData["Title"] = "Create Board";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1>Create Board</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SortOrder" class="form-label"></label>
                            <input asp-for="SortOrder" class="form-control" type="number" />
                            <span asp-validation-for="SortOrder" class="text-danger"></span>
                            <small class="form-text text-muted">Lower numbers appear first</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ParentId" class="form-label">Parent board</label>
                            <select asp-for="ParentId" class="form-select">
                                <option value="">(None - top-level board)</option>
                                @foreach (var parentOption in boardsForParentList.OrderBy(b => b.SortOrder))
                                {
                                    <option value="@parentOption.Id">@parentOption.Name</option>
                                }
                            </select>
                            <span asp-validation-for="ParentId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsCategory" class="form-check-input" type="checkbox" />
                                <label asp-for="IsCategory" class="form-check-label">Is category</label>
                            </div>
                            <small class="form-text text-muted">A category is an organizational header with no threads of its own.</small>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Create</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Choose a clear, descriptive name
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Add a helpful description
                        </li>
                        <li>
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Set sort order for board position
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}