@model ModerationSettings
@{
    ViewData["Title"] = "Moderation";
    Layout = "_AdminLayout";
}

<partial name="_ModerationTabs" />

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Hold new members' posts</h5>
    </div>
    <div class="card-body">
        <form asp-action="Settings" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-check form-switch mb-3">
                <input asp-for="HoldNewMemberPosts" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="HoldNewMemberPosts" class="form-check-label"></label>
                <div class="form-text">
                    A new member's posts (new discussions and replies) go to the moderation queue instead of
                    appearing straight away. Nobody else sees them until a moderator approves them.
                    Moderators and administrators are never held.
                </div>
            </div>

            <div class="mb-3" style="max-width: 240px;">
                <label asp-for="NewMemberPostThreshold" class="form-label"></label>
                <input asp-for="NewMemberPostThreshold" class="form-control" type="number" min="1" max="100" />
                <span asp-validation-for="NewMemberPostThreshold" class="text-danger"></span>
            </div>
            <p class="form-text">
                A member stops being "new" once this many of their posts are live. With 1, only their first
                post is checked. While one of their posts is waiting, any further posts wait behind it.
            </p>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
