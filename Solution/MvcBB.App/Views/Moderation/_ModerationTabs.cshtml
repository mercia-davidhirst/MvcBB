@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(currentAction == "Index" ? "active" : "")" asp-controller="Moderation" asp-action="Index">
            <i class="bi bi-hourglass-split me-1"></i>Queue
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentAction == "Log" ? "active" : "")" asp-controller="Moderation" asp-action="Log">
            <i class="bi bi-journal-text me-1"></i>Moderation log
        </a>
    </li>
    @if (User.IsInRole("Administrator"))
    {
        <li class="nav-item">
            <a class="nav-link @(currentAction == "Settings" ? "active" : "")" asp-controller="Moderation" asp-action="Settings">
                <i class="bi bi-sliders me-1"></i>Settings
            </a>
        </li>
    }
</ul>
