@using MvcBB.App.Interfaces
@inject ISettingsService SettingsService
@inject IMessageService MessageService
@{
    var displaySettings = await SettingsService.GetDisplaySettingsAsync();
    // Whatever Version/AssemblyVersion the MvcBB.App project is built with -
    // GetEntryAssembly() (not GetExecutingAssembly()) so this reads the app's
    // own version even though Razor views compile into their own assembly.
    var appVersion = System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version;
    var appVersionText = appVersion != null ? $"v{appVersion.Major}.{appVersion.Minor}.{appVersion.Build}" : null;
    var unreadMessageCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        try
        {
            unreadMessageCount = await MessageService.GetUnreadCountAsync();
        }
        catch
        {
            // Don't let a transient API/session hiccup break every page's layout.
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @displaySettings.SiteName</title>
    <script>
        // Applied before the stylesheets load so the page never flashes the
        // light theme first. The toggle button in the navbar is the only
        // other place that reads/writes this - it's a per-browser choice
        // (localStorage), not an account setting.
        (function () {
            try {
                var stored = localStorage.getItem('mvcbb-theme');
                var theme = stored || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {
                // Storage blocked (private browsing, etc.) - fall back to the light theme.
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MvcBB.App.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(displaySettings.LogoPath))
                    {
                        <img src="@displaySettings.LogoPath" alt="@displaySettings.SiteName" />
                    }
                    else
                    {
                        @displaySettings.SiteName
                    }
                </a>
                <button class="btn btn-outline-light btn-sm me-2" type="button" id="themeToggleBtn"
                        title="Toggle dark mode" aria-label="Toggle dark mode">
                    <i class="bi bi-moon-stars" id="themeToggleIcon"></i>
                </button>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Boards" asp-action="Index">Boards</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Members" asp-action="Index">Members</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Messages" asp-action="Index">
                                    <i class="bi bi-envelope"></i> Messages
                                    <span id="unreadMessageBadge" class="badge rounded-pill bg-danger @(unreadMessageCount > 0 ? "" : "d-none")">@unreadMessageCount</span>
                                </a>
                            </li>
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link text-dark dropdown-toggle" href="#" id="adminDropdown" role="button" 
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        Admin
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                                <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Users">
                                                <i class="bi bi-people me-2"></i>Users
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Boards">
                                                <i class="bi bi-grid me-2"></i>Boards
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="BBCode">
                                                <i class="bi bi-code-square me-2"></i>BBCode
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Smilies">
                                                <i class="bi bi-emoji-smile me-2"></i>Smilies
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Ranks">
                                                <i class="bi bi-award me-2"></i>Ranks
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="WordFilters">
                                                <i class="bi bi-chat-square-text me-2"></i>Word Filter
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Reports" asp-action="Index">
                                                <i class="bi bi-flag me-2"></i>Reports
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Settings">
                                                <i class="bi bi-gear me-2"></i>Settings
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("Moderator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Reports" asp-action="Index">Reports</a>
                                </li>
                            }
                        }
                    </ul>
                    <form class="d-flex me-3" asp-controller="Search" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control" type="search" name="q" placeholder="Search..." aria-label="Search">
                            <button class="btn btn-outline-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-dark dropdown-toggle" href="#" id="userDropdown" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - @displaySettings.SiteName
            @if (!string.IsNullOrEmpty(appVersionText))
            {
                <span>@appVersionText</span>
            }
            @if (!string.IsNullOrEmpty(displaySettings.FooterDisclaimer))
            {
                <div class="text-center small mt-1">@displaySettings.FooterDisclaimer</div>
            }
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
            <div id="newMessageToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-envelope-fill me-2"></i>
                        <span id="newMessageToastText">You have new private messages.</span>
                    </div>
                    <a href="/Messages" class="btn btn-sm btn-light m-2">View</a>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
        <script>
            // Baseline for the new-PM polling in site.js - avoids toasting for
            // messages already reflected in the navbar badge on page load.
            window.mvcbbInitialUnreadCount = @unreadMessageCount;
        </script>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
