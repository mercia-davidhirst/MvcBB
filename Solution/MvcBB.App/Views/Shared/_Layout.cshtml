@using MvcBB.App.Interfaces
@using MvcBB.ModKit
@inject ISettingsService SettingsService
@inject IMessageService MessageService
@inject IReportService ReportService
@inject INotificationsService NotificationsService
@inject IModerationService ModerationService
@inject IModsService ModsService
@inject IReadOnlyList<IAppMod> DiscoveredAppMods
@inject MvcBB.App.Mods.ModAdminRegistry ModAdminRegistry
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var displaySettings = await SettingsService.GetDisplaySettingsAsync();
    // Mod-contributed nav items (see MvcBB.ModKit.IAppMod) - skipped for any
    // mod the admin hasn't enabled. DiscoveredAppMods is just whichever mod
    // assemblies this process found in its own Mods/ folder at startup;
    // enabled state always comes from the API's registry, never from
    // whether the assembly happens to be present.
    var enabledModIds = await ModsService.GetEnabledModIdsAsync();
    var navModItems = DiscoveredAppMods
        .Where(m => enabledModIds.Contains(m.Id))
        .SelectMany(m => m.GetNavItems())
        .ToList();
    // Mod links beyond Navigation:MaxModLinks (appsettings.json, default 3) go
    // into a "More" menu, so each new mod doesn't widen the navbar. When there
    // are too many, the last visible place goes to the menu itself.
    var maxModLinks = Math.Max(1, Configuration.GetValue("Navigation:MaxModLinks", 3));
    var visibleModItems = navModItems.Count <= maxModLinks ? navModItems : navModItems.Take(maxModLinks - 1).ToList();
    var overflowModItems = navModItems.Skip(visibleModItems.Count).ToList();
    // Admin pages added by enabled mods, for the Admin dropdown (Administrators only).
    var modAdminItems = User.IsInRole("Administrator")
        ? await ModAdminRegistry.GetEnabledAsync(Context, ModsService)
        : Array.Empty<MvcBB.App.Mods.ModAdminRegistry.Entry>();
    // Whatever Version/AssemblyVersion the MvcBB.App project is built with -
    // GetEntryAssembly() (not GetExecutingAssembly()) so this reads the app's
    // own version even though Razor views compile into their own assembly.
    var appVersion = System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version;
    var appVersionText = appVersion != null ? $"v{appVersion.Major}.{appVersion.Minor}.{appVersion.Build}" : null;
    var unreadMessageCount = 0;
    var unreadNotificationCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        try
        {
            unreadMessageCount = await MessageService.GetUnreadCountAsync();
        }
        catch
        {
            // Don't let a transient API/session hiccup break every page's layout.
        }
        try
        {
            unreadNotificationCount = await NotificationsService.GetUnreadCountAsync();
        }
        catch
        {
            // Same: the bell just shows no count this time.
        }
    }
    // Open (Pending/Investigating) report count for the moderator/admin
    // alert badge - fetched and refreshed exactly like the unread-PM badge.
    var canModerate = User.IsInRole("Administrator") || User.IsInRole("Moderator");
    var openReportCount = 0;
    if (canModerate)
    {
        try
        {
            openReportCount = await ReportService.GetOpenCountAsync();
        }
        catch
        {
            // Same as above: never break the layout over the badge.
        }
    }
    // Posts waiting in the moderation queue, for the moderator/admin badge.
    var moderationQueueCount = 0;
    if (canModerate)
    {
        try
        {
            moderationQueueCount = await ModerationService.GetQueueCountAsync();
        }
        catch
        {
            // Same as above.
        }
    }
    // A draft the controller has just saved for real (see DraftKeys), for post-editor.js to delete.
    var clearDraftKey = TempData[DraftKeys.ClearDraftTempDataKey] as string;
    // The page the member is on, offered (not forced) on the Report an issue form.
    var currentPageUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @displaySettings.SiteName</title>
    <script>
        // Applied before the stylesheets load so the page never flashes the
        // light theme first. The toggle button in the navbar is the only
        // other place that reads/writes this - it's a per-browser choice
        // (localStorage), not an account setting.
        (function () {
            try {
                var stored = localStorage.getItem('mvcbb-theme');
                var theme = stored || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {
                // Storage blocked (private browsing, etc.) - fall back to the light theme.
            }
        })();
    </script>
    @if (!string.IsNullOrEmpty(clearDraftKey))
    {
        <meta name="mvcbb-clear-draft" content="@clearDraftKey" data-user="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
    }
    <link rel="icon" href='@Url.Content("~/favicon.ico")'>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MvcBB.App.styles.css" asp-append-version="true" />
    <mod-slot name="@CoreSlots.LayoutHead" context="@(new PageSlotContext { ViewerUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value })" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(displaySettings.LogoPath))
                    {
                        <img src="@displaySettings.LogoPath" alt="@displaySettings.SiteName" />
                    }
                    else
                    {
                        @displaySettings.SiteName
                    }
                </a>
                <button class="btn btn-outline-light btn-sm me-2" type="button" id="themeToggleBtn"
                        title="Toggle dark mode" aria-label="Toggle dark mode">
                    <i class="bi bi-moon-stars" id="themeToggleIcon"></i>
                </button>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Boards" asp-action="Index">Boards</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Members" asp-action="Index">Members</a>
                        </li>
                        @foreach (var navItem in visibleModItems)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="@navItem.Controller" asp-action="@navItem.Action">
                                    <i class="bi @navItem.IconCssClass"></i> @navItem.Text
                                </a>
                            </li>
                        }
                        @if (overflowModItems.Count > 0)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-dark dropdown-toggle" href="#" id="moreModsDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-list"></i> More
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="moreModsDropdown">
                                    @foreach (var navItem in overflowModItems)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="@navItem.Controller" asp-action="@navItem.Action">
                                                <i class="bi @navItem.IconCssClass me-2"></i>@navItem.Text
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Messages" asp-action="Index">
                                    <i class="bi bi-envelope"></i> Messages
                                    <span id="unreadMessageBadge" class="badge rounded-pill bg-danger @(unreadMessageCount > 0 ? "" : "d-none")">@unreadMessageCount</span>
                                </a>
                            </li>
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link text-dark dropdown-toggle" href="#" id="adminDropdown" role="button" 
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        Admin
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                                <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Announcements">
                                                <i class="bi bi-megaphone me-2"></i>Announcements
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="BBCode">
                                                <i class="bi bi-code-square me-2"></i>BBCode
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Boards">
                                                <i class="bi bi-grid me-2"></i>Boards
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AdminEmails" asp-action="Index">
                                                <i class="bi bi-envelope me-2"></i>Email Users
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AdminEmails" asp-action="Activity">
                                                <i class="bi bi-bar-chart me-2"></i>Sending activity
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Moderation" asp-action="Index">
                                                <i class="bi bi-shield-check me-2"></i>Moderation
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Mods" asp-action="Index">
                                                <i class="bi bi-puzzle me-2"></i>Mods
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Ranks">
                                                <i class="bi bi-award me-2"></i>Ranks
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Reports" asp-action="Index">
                                                <i class="bi bi-flag me-2"></i>Reports
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Settings">
                                                <i class="bi bi-gear me-2"></i>Settings
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Smilies">
                                                <i class="bi bi-emoji-smile me-2"></i>Smilies
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Users">
                                                <i class="bi bi-people me-2"></i>Users
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="WordFilters">
                                                <i class="bi bi-chat-square-text me-2"></i>Word Filter
                                            </a>
                                        </li>
                                        @if (modAdminItems.Count > 0)
                                        {
                                            @* Admin pages added by enabled mods (IAppMod.GetAdminItems). *@
                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header">Mods</h6></li>
                                            @foreach (var adminItem in modAdminItems)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="@adminItem.Item.Controller" asp-action="@adminItem.Item.Action">
                                                        <i class="bi @adminItem.Item.IconCssClass me-2"></i>@adminItem.Item.Text
                                                    </a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("Moderator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Reports" asp-action="Index">Reports</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Moderation" asp-action="Index">Moderation</a>
                                </li>
                            }
                        }
                    </ul>
                    <form class="d-flex me-3" asp-controller="Search" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control" type="search" name="q" placeholder="Search..." aria-label="Search">
                            <button class="btn btn-outline-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <mod-slot name="@CoreSlots.LayoutNavbar" context="@(new PageSlotContext { ViewerUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value })" />
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Notifications" asp-action="Index"
                                   title="Notifications" aria-label="Notifications" data-bs-toggle="tooltip" data-bs-placement="bottom">
                                    <i class="bi bi-bell"></i>
                                    <span id="unreadNotificationBadge" class="badge rounded-pill bg-danger @(unreadNotificationCount > 0 ? "" : "d-none")">@unreadNotificationCount</span>
                                </a>
                            </li>
                            if (canModerate)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Moderation" asp-action="Index"
                                       title="Posts waiting for approval" aria-label="Posts waiting for approval" data-bs-toggle="tooltip" data-bs-placement="bottom">
                                        <i class="bi bi-hourglass-split"></i>
                                        <span id="moderationQueueBadge" class="badge rounded-pill bg-info text-dark @(moderationQueueCount > 0 ? "" : "d-none")">@moderationQueueCount</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Reports" asp-action="Index"
                                       title="Open reports" aria-label="Open reports" data-bs-toggle="tooltip" data-bs-placement="bottom">
                                        <i class="bi bi-flag"></i>
                                        <span id="openReportBadge" class="badge rounded-pill bg-warning text-dark @(openReportCount > 0 ? "" : "d-none")">@openReportCount</span>
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reports" asp-action="ReportIssue" asp-route-pageUrl="@currentPageUrl"
                                   title="Report an issue" aria-label="Report an issue" data-bs-toggle="tooltip" data-bs-placement="bottom">
                                    <i class="bi bi-bug"></i>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-dark dropdown-toggle" href="#" id="userDropdown" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @await Component.InvokeAsync("AnnouncementBanner")
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* Floating "Back to top" button, shown once the page has scrolled down (see site.js). *@
    <button type="button" id="backToTopBtn" class="back-to-top" title="Back to top" aria-label="Back to top" hidden>
        <i class="bi bi-arrow-up"></i>
    </button>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @((await Html.ForumNowAsync()).Year) - @displaySettings.SiteName
            @if (!string.IsNullOrEmpty(appVersionText))
            {
                <span>@appVersionText</span>
            }
            @if (!string.IsNullOrEmpty(displaySettings.FooterDisclaimer))
            {
                <div class="text-center small mt-1 text-preserve-lines">@displaySettings.FooterDisclaimer</div>
            }
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
            <div id="newMessageToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-envelope-fill me-2"></i>
                        <span id="newMessageToastText">You have new private messages.</span>
                    </div>
                    <a href="/Messages" class="btn btn-sm btn-light m-2">View</a>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
        <script>
            // Baseline for the new-PM polling in site.js - avoids toasting for
            // messages already reflected in the navbar badge on page load.
            window.mvcbbInitialUnreadCount = @unreadMessageCount;
            window.mvcbbInitialNotificationCount = @unreadNotificationCount;
        </script>
        @* Moderation alerts. Mods add their own toasts here (layout.toasts) so
           they stack with the open-reports one instead of overlapping it. *@
        <div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1080;">
            @if (canModerate)
            {
                <div id="newReportToast" class="toast align-items-center text-bg-warning border-0" role="alert" aria-live="polite" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-flag-fill me-2"></i>
                            <span id="newReportToastText">There are new reports to review.</span>
                        </div>
                        <a href="/Reports" class="btn btn-sm btn-light m-2">View</a>
                        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            }
            <mod-slot name="@CoreSlots.LayoutToasts" context="@(new PageSlotContext { ViewerUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value })" />
        </div>
        @if (canModerate)
        {
            <script>
                // Baseline for the open-reports polling in site.js.
                window.mvcbbInitialOpenReportCount = @openReportCount;
                window.mvcbbInitialModerationQueueCount = @moderationQueueCount;
            </script>
        }
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/post-editor.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
