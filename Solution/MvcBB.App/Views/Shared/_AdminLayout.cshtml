@{
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
            <div class="position-sticky pt-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Announcements" ? "active" : "")"
                           asp-controller="Admin" asp-action="Announcements">
                            <i class="bi bi-megaphone me-2"></i>
                            Announcements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "BBCode" ? "active" : "")"
                           asp-controller="Admin" asp-action="BBCode">
                            <i class="bi bi-code-square me-2"></i>
                            BBCode
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @((ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Boards") || ViewContext.RouteData.Values["Controller"]?.ToString() == "Boards" ? "active" : "")"
                           asp-controller="Admin" asp-action="Boards">
                            <i class="bi bi-grid me-2"></i>
                            Boards
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminEmails" && ViewContext.RouteData.Values["Action"]?.ToString() != "Activity" ? "active" : "")"
                           asp-controller="AdminEmails" asp-action="Index">
                            <i class="bi bi-envelope me-2"></i>
                            Email Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ps-4 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminEmails" && ViewContext.RouteData.Values["Action"]?.ToString() == "Activity" ? "active" : "")"
                           asp-controller="AdminEmails" asp-action="Activity">
                            <i class="bi bi-bar-chart me-2"></i>
                            Sending activity
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mods" ? "active" : "")"
                           asp-controller="Mods" asp-action="Index">
                            <i class="bi bi-puzzle me-2"></i>
                            Mods
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Ranks" ? "active" : "")"
                           asp-controller="Admin" asp-action="Ranks">
                            <i class="bi bi-award me-2"></i>
                            Ranks
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")"
                           asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-flag me-2"></i>
                            Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")"
                           asp-controller="Admin" asp-action="Settings">
                            <i class="bi bi-gear me-2"></i>
                            Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Smilies" ? "active" : "")"
                           asp-controller="Admin" asp-action="Smilies">
                            <i class="bi bi-emoji-smile me-2"></i>
                            Smilies
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" && (ViewContext.RouteData.Values["Action"]?.ToString() is "Users" or "ManageUser" or "CreateUser") ? "active" : "")"
                           asp-controller="Account" asp-action="Users">
                            <i class="bi bi-people me-2"></i>
                            Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "WordFilters" ? "active" : "")"
                           asp-controller="Admin" asp-action="WordFilters">
                            <i class="bi bi-funnel me-2"></i>
                            Word Filters
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">@ViewData["Title"]</h1>
            </div>
            @RenderBody()
        </main>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
} 
